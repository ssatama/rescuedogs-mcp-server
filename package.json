{
  "name": "rescuedogs-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for discovering rescue dogs from European and UK organizations",
  "main": "dist/index.js",
  "bin": {
    "rescuedogs-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev:http": "tsx src/http.ts",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:dead": "knip",
    "lint:links": "node scripts/check-links.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "rescue-dogs",
    "dog-adoption",
    "claude",
    "llm",
    "model-context-protocol"
  ],
  "author": "Sampo Satama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssatama/rescuedogs-mcp-server.git"
  },
  "homepage": "https://www.rescuedogs.me",
  "bugs": {
    "url": "https://github.com/ssatama/rescuedogs-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.15.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "node-cache": "^5.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "knip": "^6.32.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md"
  ]
}
